# Gemini 무료 키: https://aistudio.google.com 에서 발급
# OpenAI 호환 엔드포인트라면 다른 제공자(GitHub Models, Groq, Ollama 등)로 바꿔도 된다.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=여기에_키_입력

# 노드별 모델 지정(선택). 무료 한도가 모델별로 따로 계산되므로 나눠 쓰면 하루 사용량이 늘어난다.
# 형식: LLM_MODEL_<노드 이름 대문자> — 없으면 LLM_MODEL을 쓴다.
# LLM_MODEL_EXTRACT=gemini-3.5-flash-lite
# LLM_MODEL_JUDGE=gemini-3.6-flash

# 개발·평가용 응답 캐시(선택). 1이면 같은 요청은 data/llm_cache/에 저장한 응답을 재사용해 한도를 쓰지 않는다.
# LLM_CACHE=1
